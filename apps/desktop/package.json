{
	"name": "@roo-code/desktop",
	"version": "1.0.0",
	"description": "Roo Code Desktop - Full-featured Autonomous AI Developer Desktop Application",
	"private": true,
	"type": "module",
	"main": "dist/main/index.js",
	"bin": {
		"roo-desktop": "dist/cli.js"
	},
	"author": {
		"name": "Roo Code"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"build": "node build.mjs",
		"start": "node dist/cli.js --electron",
		"web": "node dist/cli.js --web",
		"dev": "node dist/cli.js --web --dev",
		"package:win": "node package-installer.mjs",
		"package:win:builder": "node package-installer.mjs --skip-build",
		"package:win:verify": "node package-installer.mjs --verify-only",
		"package:win:artifact": "electron-builder --win --x64",
		"package:dir": "node build.mjs && electron-builder --win --dir",
		"package:dir:builder": "electron-builder --win --dir",
		"build:installer": "node package-installer.mjs",
		"clean": "rimraf dist release .turbo"
	},
	"dependencies": {
		"@roo-code/core": "workspace:^",
		"@roo-code/types": "workspace:^",
		"@roo-code/vscode-shim": "workspace:^",
		"commander": "^12.1.0",
		"open": "^10.1.0",
		"p-wait-for": "^5.0.2",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@roo-code/config-eslint": "workspace:^",
		"@roo-code/config-typescript": "workspace:^",
		"@types/node": "^24.1.0",
		"@types/ws": "^8.5.14",
		"electron": "^34.0.0",
		"electron-builder": "^26.15.3",
		"esbuild": "^0.25.0",
		"rimraf": "^6.0.1",
		"typescript": "5.8.3",
		"vitest": "^3.2.3"
	},
	"build": {
		"appId": "com.roocode.desktop",
		"productName": "Roo Code",
		"copyright": "Copyright © 2026 Roo Code",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"assets/**/*",
			"package.json"
		],
		"extraResources": [
			{
				"from": "dist/node_modules/@vscode/ripgrep",
				"to": "node_modules/@vscode/ripgrep"
			}
		],
		"asarUnpack": [
			"dist/node_modules/@vscode/ripgrep/**/*",
			"dist/engine/**/*",
			"dist/webview/**/*",
			"dist/renderer/**/*",
			"dist/preload/**/*",
			"**/*.wasm",
			"**/*.node"
		],
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "assets/icon.ico"
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": false,
			"createStartMenuShortcut": true,
			"shortcutName": "Roo Code",
			"runAfterFinish": true,
			"installerLanguages": [
				"pl_PL",
				"en_US"
			],
			"language": "1045",
			"displayLanguageSelector": false,
			"deleteAppDataOnUninstall": false,
			"include": "build/installer.nsh"
		}
	}
}
